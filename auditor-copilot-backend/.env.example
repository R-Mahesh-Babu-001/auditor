# ==============================================================================
# AUDITREADY COPILOT - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (NEON POSTGRESQL + PGVECTOR)
# ------------------------------------------------------------------------------
# Connects to your Neon serverless PostgreSQL instance with connection pooling.
# The audit system uses the pre-provisioned 'audit_copilot' schema (47 tables).
DATABASE_URL=postgresql://user:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
NEON_SCHEMA=audit_copilot

# ------------------------------------------------------------------------------
# 2. LLM CONFIGURATION (GOOGLE GEMINI ONLY)
# ------------------------------------------------------------------------------
# Google Gemini is the exclusive LLM provider. Azure OpenAI and AWS Bedrock are removed.
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional: Dedicated embeddings API key (falls back to GEMINI_API_KEY if omitted)
# GEMINI_EMBEDDING_API_KEY=your_google_gemini_embedding_api_key_here

# ------------------------------------------------------------------------------
# 3. SERVER & STORAGE CONFIGURATION
# ------------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Local / Object storage root for uploaded evidence bytes (keeps Postgres storage lean)
EVIDENCE_STORAGE_DIR=storage/evidence_uploads
