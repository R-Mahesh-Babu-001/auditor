# ==============================================================================
# AUDITREADY COPILOT - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (NEON POSTGRESQL + PGVECTOR)
# ------------------------------------------------------------------------------
# Connects to your Neon serverless PostgreSQL instance with connection pooling.
# The audit system uses the pre-provisioned 'audit_copilot' schema (47 tables).
DATABASE_URL=postgresql://user:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
NEON_SCHEMA=audit_copilot

# ------------------------------------------------------------------------------
# 2. VECTOR DATABASE CONFIGURATION (QDRANT CLOUD FREE)
# ------------------------------------------------------------------------------
# Qdrant Cloud Free is the dedicated vector database for semantic policy/document retrieval.
VECTOR_STORE_PROVIDER=qdrant
QDRANT_URL=https://your-cluster-id.us-east4-0.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=audit_evidence
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001

# ------------------------------------------------------------------------------
# 3. LLM CONFIGURATION (GOOGLE GEMINI ONLY)
# ------------------------------------------------------------------------------
# Google Gemini is the exclusive LLM provider. Azure OpenAI and AWS Bedrock are removed.
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
# Optional: GOOGLE_API_KEY can be used alternatively
# GOOGLE_API_KEY=your_google_gemini_api_key_here

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
APP_ENV=development
JWT_SECRET_KEY=your_jwt_secret_signing_key_change_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# ------------------------------------------------------------------------------
# 5. SERVER & STORAGE CONFIGURATION
# ------------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Local / Object storage root for uploaded evidence bytes (keeps Postgres storage lean)
EVIDENCE_STORAGE_DIR=storage/evidence_uploads
